[Unit]
Description=Slow DNS VPN - dnstt DNS tunnel server
Documentation=https://www.bamsoftware.com/software/dnstt/
After=network-online.target slowdns-ssh.service
Wants=network-online.target
Requires=slowdns-ssh.service
# Restart-loop ceiling: give up if it fails this many times within this
# window, instead of restarting forever. Values come from server.conf's
# LOW_PROFILE_MODE setting - see README "Low-Profile Mode".
StartLimitIntervalSec=__STARTLIMITINTERVAL__
StartLimitBurst=__STARTLIMITBURST__

[Service]
Type=simple
ExecStart=__EXEC__
User=__USER__
Group=__GROUP__

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute is intentionally NOT set: it is known to crash Go
# binaries on some kernel/Go version combinations (Go's runtime briefly
# needs W+X memory during startup on some architectures).

# Resource ceiling (infinity = unlimited = today's default behavior; only
# Low-Profile Mode sets a concrete cap). dnstt-server is a single lightweight
# process, so this is a generous safety net, not a normal-use constraint.
MemoryMax=__TUNNELMEMORYMAX__
TasksMax=__TUNNELTASKSMAX__

Restart=on-failure
RestartSec=__RESTARTSEC__
TimeoutStopSec=__TIMEOUTSTOP__
StandardOutput=journal
StandardError=journal
SyslogIdentifier=slowdns-tunnel

[Install]
WantedBy=multi-user.target
